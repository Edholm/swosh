# Settings for docker-compose.yml. Copy this file to .env, which compose reads
# by default, or to a file such as .env.prod that you pass with --env-file.
# Those files hold secrets and are git-ignored. A local `docker compose up`
# also runs without one.
#
# Commented-out settings keep swosh's defaults; see README.md.

# Password of the swosh database user. docker-compose.yml puts it in
# SWOSH_DATABASE_URL, so keep it URL-safe: `openssl rand -hex 24`. Postgres
# only reads it when it creates the volume. Set it in production.
POSTGRES_PASSWORD=

# Signs login cookies; at least 32 bytes: `openssl rand -hex 32`. Without it,
# every restart logs everyone out. Set it in production.
SWOSH_SESSION_KEY=

# The admin user created on startup unless it already exists. The password
# must not be empty, and production needs a real one, not "admin".
#SWOSH_PROVISION_USERS=true
#SWOSH_ADMIN_USERNAME=admin
SWOSH_ADMIN_PWD=

# The public URL of created links, e.g. staging.swosh.me on staging.
#SWOSH_SCHEME=https
#SWOSH_HOSTNAME=swosh.me

#LOG_LEVEL=info
#SWOSH_EXPIRE_RATE=60000

# Metric labels.
#SWOSH_ENVIRONMENT=local
#SWOSH_SERVER_HOSTNAME=

# The image and the host ports.
#SWOSH_IMAGE=ko.local/swosh
#TAG=latest
#APP_PORT=8080
#ACTUATOR_PORT=8081
