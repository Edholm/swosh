# Settings for docker-compose.yml. Copy this file to .env.prod or .env.staging
# for deploy.sh, or to .env for a local `docker compose up` (which also runs
# without one). Those files hold secrets and are git-ignored.
#
# Commented-out settings keep swosh's defaults; see README.md.

# Password of the swosh database user. docker-compose.yml puts it in
# SWOSH_DATABASE_URL, so keep it URL-safe: `openssl rand -hex 24`. Postgres
# only reads it when it creates the volume. Required by deploy.sh.
POSTGRES_PASSWORD=

# Signs login cookies; at least 32 bytes: `openssl rand -hex 32`. Without it,
# every restart logs everyone out. Required by deploy.sh.
SWOSH_SESSION_KEY=

# The admin user created on startup unless it already exists. The password
# must not be empty, and deploy.sh refuses the default "admin".
#SWOSH_PROVISION_USERS=true
#SWOSH_ADMIN_USERNAME=admin
SWOSH_ADMIN_PWD=

# The public URL of created links. deploy.sh sets these for each environment.
#SWOSH_SCHEME=https
#SWOSH_HOSTNAME=swosh.me

#LOG_LEVEL=info
#SWOSH_EXPIRE_RATE=60000

# Metric labels.
#SWOSH_ENVIRONMENT=local
#SWOSH_SERVER_HOSTNAME=

# The image and the host ports. deploy.sh sets SWOSH_IMAGE and TAG.
#SWOSH_IMAGE=ko.local/swosh
#TAG=latest
#APP_PORT=8080
#ACTUATOR_PORT=8081
